APP_NAME="Curdun ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/curdun-ict-ERP-system-main/backend
APP_VERSION=1.0.0
APP_TIMEZONE=Africa/Mogadishu

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=curdun_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=7200
SESSION_NAME=curdun_session

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Public frontend address used in password links
APP_PUBLIC_URL=http://127.0.0.1:8000

# Email: smtp | mail | log. Keep "log" locally; use smtp in production.
MAIL_TRANSPORT=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@curdun.so
MAIL_FROM_NAME="Curdun ICT Solution"

# SMS: http | log. HTTP gateways receive {to,message,sender} JSON + Bearer token.
SMS_TRANSPORT=log
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=CURDUN

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=storage/uploads

RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DECAY=300
