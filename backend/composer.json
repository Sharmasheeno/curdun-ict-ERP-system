{
    "name": "curdun/erp",
    "description": "Curdun ERP Backend - COR Platform by CURDUN ICT Solutions",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.5",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "helpers/response.php",
            "helpers/validation.php",
            "helpers/security.php",
            "helpers/formatting.php",
            "helpers/permissions.php",
            "helpers/pagination.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
