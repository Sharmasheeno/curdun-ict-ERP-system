APP_NAME="Curdun ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/curdun-ict-ERP-system-main/backend
APP_VERSION=1.0.0
APP_TIMEZONE=Africa/Mogadishu

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=curdun_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=7200
SESSION_NAME=curdun_session

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=storage/uploads

RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DECAY=300
